# Copy this file to .env, then fill in the model ID exposed by your vLLM server.
# Nemotron streaming STT. Replace localhost if your service is hosted elsewhere.
GHOSTPILOT_STT_PROVIDER=nemotron
GHOSTPILOT_STT_WS_URL=ws://localhost:6010/v1/stt/stream
GHOSTPILOT_STT_HEALTH_URL=http://localhost:6010/health

# OpenAI-compatible streaming dialogue.
GHOSTPILOT_DIALOGUE_PROVIDER=openai-compatible
GHOSTPILOT_DIALOGUE_BASE_URL=http://localhost:3308/v1
GHOSTPILOT_DIALOGUE_API_KEY=anything
GHOSTPILOT_DIALOGUE_MODEL=
# Optional server-specific request fields. For llama.cpp/Qwen this suppresses thinking.
GHOSTPILOT_DIALOGUE_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
GHOSTPILOT_DIALOGUE_MAX_TOKENS=256
